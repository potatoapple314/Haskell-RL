cabal-version:      2.4
name:               haskell-rl
version:            0.1.0.0
synopsis:           Q-learning demo using the lens package
build-type:         Simple

executable haskell-rl
    main-is:          main.hs
    build-depends:    base >=4 && <5
                    , containers
                    , lens
                    , random
    default-language: Haskell2010
    ghc-options:      -Wall
